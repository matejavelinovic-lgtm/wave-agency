---
/*
 * /blog/<slug>/ — one post, from the markdown file of the same name.
 *
 * The words come from src/content/blog/*.md, not copy.json: the dev editor
 * writes single strings, and an article is a document. The chrome around the
 * article — the CTA under it — still reads copy.blog, so the sentences that are
 * not the post stay editable in the browser like every other page.
 */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_URL, SITE_NAME, PERSON } from '../../consts';
import copy from '../../content/copy.json';
import { getPublishedPosts, formatDate, readingTime, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { slug: post.id },
    /*
     * The two neighbours travel with the post rather than being looked up at
     * render time: getStaticPaths already holds the sorted list, so "the next
     * one down the page" is the entry after this one and costs nothing here.
     */
    props: {
      post,
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { blog } = copy;
const { Content, headings } = await render(post);

const url = `${SITE_URL}/blog/${post.id}/`;
const minutes = readingTime(post.body ?? '');
const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;

/*
 * The cover, rendered once at a sane width so the same file can be a 4000px
 * export without anyone paying for it. getImage is not needed — <Image> below
 * emits the resized asset, and this is only for the schema and the OG tag.
 */
const coverSrc = post.data.cover ? new URL(post.data.cover.src, SITE_URL).href : undefined;

/*
 * Table of contents, from the H2s the markdown itself produced. Two or fewer
 * and there is nothing to navigate, so the block does not render at all rather
 * than showing a list shorter than the paragraph above it. H3s stay out: a
 * nested TOC on a post this length is furniture, not navigation.
 *
 * The FAQ is appended by hand because it is not part of the body — it comes off
 * the frontmatter and renders as its own section below, and a contents list
 * that stops before the last section on the page is a contents list a reader
 * stops trusting.
 */
const toc = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
  ...(post.data.faq.length > 0 ? [{ slug: 'faq', text: copy.blog.faqTitle }] : []),
];

/*
 * The post's own FAQPage, built from the same pairs the accordion renders. One
 * source, so a question cannot be answered one way on the page and another way
 * in the markup a crawler reads.
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${url}#faq`,
  mainEntity: post.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

/*
 * BlogPosting, pointing author and publisher at the Person and Organization
 * nodes Layout emits on every page rather than describing either again — same
 * @id, so a crawler reads one company that publishes, not one per post.
 * mainEntityOfPage is what says "this markup is about THIS URL", which matters
 * on a page that also carries the site-wide nodes.
 */
const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#post`,
  headline: post.data.title,
  description: post.data.description,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@id': `${SITE_URL}/#person` },
  publisher: { '@id': `${SITE_URL}/#organization` },
  isPartOf: { '@id': `${SITE_URL}/blog/#blog` },
  inLanguage: 'en',
  wordCount: words,
  timeRequired: `PT${minutes}M`,
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
  ...(coverSrc && { image: coverSrc }),
};
---

<Layout
  title={`${post.data.metaTitle ?? post.data.title} | ${SITE_NAME}`}
  description={post.data.description}
  breadcrumbs={[
    { name: 'Blog', path: '/blog/' },
    { name: post.data.title, path: `/blog/${post.id}/` },
  ]}
  ogType="article"
  image={post.data.cover?.src}
>
  <article class="post">
    <header class="post-hero">
      <div class="post-hero-inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a class="crumb-link" href="/">Home</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <a class="crumb-link" href="/blog/">Blog</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span class="crumb-here">{post.data.title}</span>
        </nav>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-lede">{post.data.description}</p>
        <div class="post-meta">
          <span class="post-author">{PERSON.name}</span>
          <span class="post-meta-dot" aria-hidden="true"></span>
          <time class="post-date" datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span class="post-meta-dot" aria-hidden="true"></span>
          <span class="post-time">{minutes} min read</span>
          {post.data.draft && <span class="blog-card-draft">Draft</span>}
        </div>
        {
          post.data.updatedDate && (
            <p class="post-updated">
              Updated{' '}
              <time datetime={post.data.updatedDate.toISOString()}>
                {formatDate(post.data.updatedDate)}
              </time>
            </p>
          )
        }
        {
          post.data.tags.length > 0 && (
            <div class="blog-tags">
              {post.data.tags.map((tag) => (
                <span class="blog-tag">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="seam-to-light"></div>

    <div class="post-body-section">
      <div class="post-body-inner">
        {
          post.data.cover && (
            <Image
              class="post-cover"
              src={post.data.cover}
              alt={post.data.coverAlt ?? ''}
              widths={[640, 960, 1280]}
              sizes="(max-width: 800px) 100vw, 760px"
              loading="eager"
            />
          )
        }

        {
          post.data.takeaways.length > 0 && (
            <aside class="post-takeaways" aria-labelledby="post-takeaways-title">
              <span class="post-takeaways-title" id="post-takeaways-title" data-edit="blog.takeawaysTitle">
                {copy.blog.takeawaysTitle}
              </span>
              <ul class="post-takeaways-list">
                {post.data.takeaways.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </aside>
          )
        }

        {
          toc.length > 2 && (
            <nav class="post-toc" aria-labelledby="post-toc-title">
              <span class="post-toc-title" id="post-toc-title">
                In this post
              </span>
              <ol class="post-toc-list">
                {toc.map((heading) => (
                  <li>
                    <a class="post-toc-link" href={`#${heading.slug}`}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        {/*
          The one place on the site where styling hangs off element selectors
          instead of one class per element: markdown produces the tags, so there
          is nothing to hang a class on. The rules live under .post-body in
          main.css and reach nothing outside this wrapper.
        */}
        <div class="post-body">
          <Content />
        </div>

        <div class="post-share">
          <span class="post-share-label">Written by</span>
          <a class="post-share-link" href={PERSON.linkedin} rel="noopener" target="_blank">
            {PERSON.name}
          </a>
        </div>
      </div>
    </div>

    {/*
      The FAQ, from the frontmatter rather than the body. Same accordion markup
      and same behaviour as the homepage and the service pages — one panel open
      at a time, the button owns the aria state — so a reader who has used the
      site already knows how it works. It sits inside the article element on
      purpose: these questions are part of the post, not site-wide chrome.
    */}
    {
      post.data.faq.length > 0 && (
        <section class="faq post-faq" id="faq">
          <div class="post-faq-inner">
            <h2 class="post-faq-title" data-edit="blog.faqTitle">
              {copy.blog.faqTitle}
            </h2>
            <div class="faq-list">
              {post.data.faq.map((item, i) => (
                <div class="faq-item">
                  <button
                    class="faq-question"
                    type="button"
                    id={`faq-trigger-${i}`}
                    aria-expanded="false"
                    aria-controls={`faq-panel-${i}`}
                  >
                    <span class="faq-question-text">{item.q}</span>
                    <span class="faq-icon" aria-hidden="true" />
                  </button>
                  <div
                    class="faq-panel"
                    id={`faq-panel-${i}`}
                    role="region"
                    aria-labelledby={`faq-trigger-${i}`}
                  >
                    <div class="faq-panel-clip">
                      <p class="faq-answer">{item.a}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <noscript>
              {/* is:inline keeps this rule inside the noscript — without it
                  Astro hoists it into the global bundle and every panel on the
                  site stays open. */}
              <style is:inline>
                .faq-panel { grid-template-rows: 1fr; visibility: visible; }
                .faq-icon { display: none; }
              </style>
            </noscript>
          </div>
        </section>
      )
    }

    <div class="seam-to-dark"></div>

    {
      (newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          <div class="post-nav-inner">
            <span class="post-nav-title" data-edit="blog.moreTitle">
              {blog.moreTitle}
            </span>
            <div class="post-nav-grid">
              {older && (
                <a class="post-nav-card" href={`/blog/${older.id}/`}>
                  <span class="post-nav-dir">Older</span>
                  <span class="post-nav-card-title">{older.data.title}</span>
                </a>
              )}
              {newer && (
                <a class="post-nav-card" href={`/blog/${newer.id}/`}>
                  <span class="post-nav-dir">Newer</span>
                  <span class="post-nav-card-title">{newer.data.title}</span>
                </a>
              )}
            </div>
            <a class="post-nav-all" href="/blog/">All posts →</a>
          </div>
        </nav>
      )
    }

    <section class="svc-cta">
      <div class="svc-cta-inner">
        <h2 class="svc-cta-title" data-edit="blog.ctaTitle">{blog.ctaTitle}</h2>
        <p class="svc-cta-text" data-edit="blog.ctaText">{blog.ctaText}</p>
        <a class="btn-primary" href="/#contact" data-edit="blog.ctaButton">{blog.ctaButton}</a>
        <div class="svc-siblings">
          <span class="svc-siblings-label">Services</span>
          {
            copy.servicePages.map((page) => (
              <a class="svc-sibling" href={`/${page.slug}/`}>
                {page.crumb}
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </article>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(postSchema)} />
  {
    post.data.faq.length > 0 && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    )
  }

  <script>
    // Same accordion as the homepage and the service pages: one panel open at a
    // time, the button owns the aria state, the item owns the class that drives
    // the height animation. A post without an FAQ finds no items and does
    // nothing.
    const faqItems = Array.from(document.querySelectorAll('.faq-item'));

    faqItems.forEach((item) => {
      const trigger = item.querySelector('.faq-question');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const willOpen = !item.classList.contains('is-open');

        faqItems.forEach((other) => {
          other.classList.remove('is-open');
          other.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
        });

        if (willOpen) {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>

  <script>
    // Same motion contract as the rest of the site: the ~136 kB of GSAP and
    // Lenis load only on a pointer-capable screen that has not asked for
    // reduced motion. The article is fully readable without any of it.
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isSmallScreen = window.matchMedia('(max-width: 900px)').matches;

    if (!prefersReducedMotion && !isSmallScreen) {
      const [{ gsap }, { ScrollTrigger }, { default: Lenis }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
        import('lenis'),
      ]);

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({ duration: 0.9, smoothWheel: true });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);

      gsap.from('.site-header', { opacity: 0, duration: 0.7, ease: 'power2.out' });
      gsap.from('.nav-link, .nav-cta', {
        y: 10,
        opacity: 0,
        duration: 0.5,
        stagger: 0.06,
        delay: 0.25,
        ease: 'power2.out',
      });

      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .from('.crumbs', { y: 12, opacity: 0, duration: 0.5 }, 0.1)
        .from('.post-title', { y: 30, opacity: 0, duration: 0.8 }, 0.18)
        .from('.post-lede', { y: 20, opacity: 0, duration: 0.7 }, 0.4)
        .from('.post-meta', { y: 14, opacity: 0, duration: 0.6 }, 0.55)
        .from('.blog-tags', { y: 14, opacity: 0, duration: 0.6 }, 0.65);

      // The body animates by block, not by paragraph: a reader scrolling into
      // the middle of an article should meet text, not a fade waiting its turn.
      gsap.from(['.post-cover', '.post-takeaways', '.post-toc'], {
        scrollTrigger: { trigger: '.post-body-inner', start: 'top 88%' },
        y: 24,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power3.out',
      });

      gsap.from('.post-body > h2', {
        scrollTrigger: { trigger: '.post-body', start: 'top 90%' },
        y: 18,
        opacity: 0,
        duration: 0.5,
        stagger: 0.08,
        ease: 'power3.out',
      });

      gsap.from(['.post-faq-title', '.post-faq .faq-item'], {
        scrollTrigger: { trigger: '.post-faq', start: 'top 82%' },
        y: 20,
        opacity: 0,
        duration: 0.55,
        stagger: 0.07,
        ease: 'power3.out',
      });

      gsap.from('.post-nav-card', {
        scrollTrigger: { trigger: '.post-nav', start: 'top 85%' },
        y: 24,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power3.out',
      });

      gsap.from('.svc-cta-inner', {
        scrollTrigger: { trigger: '.svc-cta', start: 'top 78%' },
        scale: 0.97,
        duration: 0.9,
        ease: 'power3.out',
      });

      gsap.from(['.svc-cta-title', '.svc-cta-text', '.svc-cta .btn-primary', '.svc-siblings'], {
        scrollTrigger: { trigger: '.svc-cta', start: 'top 75%' },
        y: 24,
        opacity: 0,
        duration: 0.7,
        stagger: 0.1,
        ease: 'power3.out',
      });

      gsap.from('.footer-inner', {
        scrollTrigger: { trigger: '.site-footer', start: 'top 92%' },
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: 'power3.out',
      });

      window.addEventListener('load', () => {
        lenis.resize();
        ScrollTrigger.refresh();
      });
    }
  </script>
</Layout>
