---
/*
 * The service pages and the migration pages, from one template.
 *
 * Each entry in copy.servicePages is a page, and its `slug` is its URL. One
 * template rather than three files because the pages differ only in their words:
 * a change to the shape of a service page should be one edit, not three that
 * drift apart. Adding a fourth service means adding an entry to copy.json — no
 * file here, no route to register, and @astrojs/sitemap picks it up on the next
 * build because getStaticPaths declared it.
 *
 * Every visible sentence still lives in src/content/copy.json and still renders
 * inside a data-edit, same contract as the homepage. The paths are indexed —
 * `servicePages.0.subtitle` — because the dev editor's path pattern allows only
 * letters, digits and underscores, and every slug here has a hyphen in it. That
 * makes the ORDER of the array load bearing: reordering it repoints every
 * data-edit on these pages. Add to the end.
 *
 * copy.migrationPages builds here too — "Webflow to Astro" and whatever platform
 * comes next. Same shape, same template, plus a `parent`: the slug of the
 * service page they sit under, which sets their breadcrumb and puts them in the
 * "By platform" row on that page. They stay out of servicePages because that
 * list is the homepage cards and the header menu, and both are meant to hold
 * three. A new migration page is a new entry at the end of migrationPages.
 */
import Layout from '../layouts/Layout.astro';
import ServiceProof from '../components/ServiceProof.astro';
import { SITE_URL } from '../consts';
import copy from '../content/copy.json';

export function getStaticPaths() {
  return [
    ...copy.servicePages.map((page, index) => ({
      params: { service: page.slug },
      props: { page, base: `servicePages.${index}`, parentSlug: undefined },
    })),
    ...copy.migrationPages.map((page, index) => ({
      params: { service: page.slug },
      props: { page, base: `migrationPages.${index}`, parentSlug: page.parent },
    })),
  ];
}

const { page, base, parentSlug } = Astro.props;

const parent = parentSlug && copy.servicePages.find((other) => other.slug === parentSlug);
if (parentSlug && !parent) {
  throw new Error(
    `copy.json: migration page "${page.slug}" has parent "${parentSlug}", which is not ` +
      `the slug of any entry in servicePages.`,
  );
}

/*
 * Trailing slash, because Astro's directory build format makes that the real
 * URL and the canonical Layout emits carries it. Every href to a service page —
 * here, the homepage cards, the footer — spells it the same way, so no internal
 * link costs a redirect and no crawler sees two spellings of one page.
 */
const url = `${SITE_URL}/${page.slug}/`;

/*
 * The Service node points its provider at the homepage Organization by @id
 * rather than describing the company again, so a crawler reading any of these
 * four pages assembles one company with three services instead of three
 * companies. Layout emits the Organization itself on every page.
 */
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: page.crumb,
  description: page.metaDescription,
  url,
  serviceType: page.crumb,
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: 'Worldwide',
  audience: {
    '@type': 'Audience',
    audienceType: 'Web3 and fintech companies',
  },
};

/*
 * The page's own FAQPage, built from the same four questions the page renders.
 * One source: the questions cannot say one thing to a reader and another to a
 * crawler, because there is only one copy of them.
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${url}#faq`,
  mainEntity: page.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

/*
 * Link rows for the bottom of the page. Never links to itself. A service page
 * lists the other services, then any migration pages under it; a migration page
 * lists the other migrations, then the services.
 */
const otherServices = copy.servicePages.filter((other) => other.slug !== page.slug);
const otherMigrations = copy.migrationPages.filter((other) => other.slug !== page.slug);
const children = copy.migrationPages.filter((other) => other.parent === page.slug);
const linkRows = (
  parent
    ? [
        { label: 'Other migrations', pages: otherMigrations },
        { label: 'Services', pages: copy.servicePages },
      ]
    : [
        { label: 'The other three', pages: otherServices },
        { label: 'By platform', pages: children },
      ]
).filter((row) => row.pages.length > 0);

const breadcrumbs = [
  ...(parent ? [{ name: parent.crumb, path: `/${parent.slug}/` }] : []),
  { name: page.crumb, path: `/${page.slug}/` },
];
---

<Layout title={page.metaTitle} description={page.metaDescription} breadcrumbs={breadcrumbs}>
  <section class="svc-hero">
    <div class="svc-hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a class="crumb-link" href="/">Home</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        {parent && (
          <>
            <a class="crumb-link" href={`/${parent.slug}/`}>{parent.crumb}</a>
            <span class="crumb-sep" aria-hidden="true">/</span>
          </>
        )}
        <span class="crumb-here" data-edit={`${base}.crumb`}>{page.crumb}</span>
      </nav>
      <span class="svc-eyebrow" data-edit={`${base}.eyebrow`}>{page.eyebrow}</span>
      {/* Three fields, not one — the accent span needs its own editable target
          and the spaces around it stay in the markup, same as the homepage H1. */}
      <h1 class="svc-title">
        <span data-edit={`${base}.titleStart`}>{page.titleStart}</span>{' '}
        <span class="svc-title-em" data-edit={`${base}.titleAccent`}>{page.titleAccent}</span>{' '}
        <span data-edit={`${base}.titleEnd`}>{page.titleEnd}</span>
      </h1>
      <p class="svc-subtitle" data-edit={`${base}.subtitle`}>{page.subtitle}</p>
      <div class="hero-actions">
        <a class="btn-primary" href="#svc-cta" data-edit={`${base}.ctaPrimary`}>{page.ctaPrimary}</a>
        <a class="btn-secondary" href="/#services" data-edit={`${base}.ctaSecondary`}
          >{page.ctaSecondary}</a
        >
      </div>
      <div class="hero-scope">
        <span class="hero-scope-label" data-edit={`${base}.signalsLabel`}>{page.signalsLabel}</span>
        {page.signals.map((s, i) => (
          <span class="scope-chip" data-edit={`${base}.signals.${i}`}>{s}</span>
        ))}
      </div>
    </div>
  </section>

  <div class="seam-to-light"></div>

  <section class="svc-pain">
    <div class="svc-pain-inner">
      <h2 class="section-title" data-edit={`${base}.painTitle`}>{page.painTitle}</h2>
      <div class="svc-pain-grid">
        {page.pain.map((item, i) => (
          <div class="svc-pain-card">
            <h3 class="svc-pain-card-title" data-edit={`${base}.pain.${i}.title`}>{item.title}</h3>
            <p class="svc-pain-card-text" data-edit={`${base}.pain.${i}.text`}>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="seam-to-dark"></div>

  <section class="svc-works">
    <div class="svc-works-inner">
      <h2 class="svc-works-title" data-edit={`${base}.worksTitle`}>{page.worksTitle}</h2>
      <ol class="svc-works-list">
        {page.works.map((item, i) => (
          <li class="svc-work">
            <span class="svc-work-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="svc-work-body">
              <h3 class="svc-work-title" data-edit={`${base}.works.${i}.title`}>{item.title}</h3>
              <p class="svc-work-text" data-edit={`${base}.works.${i}.text`}>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ServiceProof title={page.proofTitle} text={page.proofText} base={base} />

  <div class="seam-to-light"></div>

  <section class="faq">
    <div class="svc-faq-inner">
      <h2 class="section-title" data-edit={`${base}.faqTitle`}>{page.faqTitle}</h2>
      <div class="faq-list">
        {page.faq.map((item, i) => (
          <div class="faq-item">
            <button
              class="faq-question"
              type="button"
              id={`faq-trigger-${i}`}
              aria-expanded="false"
              aria-controls={`faq-panel-${i}`}
            >
              <span class="faq-question-text" data-edit={`${base}.faq.${i}.q`}>{item.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </button>
            <div
              class="faq-panel"
              id={`faq-panel-${i}`}
              role="region"
              aria-labelledby={`faq-trigger-${i}`}
            >
              <div class="faq-panel-clip">
                <p class="faq-answer" data-edit={`${base}.faq.${i}.a`}>{item.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <noscript>
        {/* is:inline keeps this rule inside the noscript — without it Astro
            hoists it into the global bundle and every panel stays open. */}
        <style is:inline>
          .faq-panel { grid-template-rows: 1fr; visibility: visible; }
          .faq-icon { display: none; }
        </style>
      </noscript>
    </div>
  </section>

  <div class="seam-to-dark"></div>

  <section class="svc-cta" id="svc-cta">
    <div class="svc-cta-inner">
      <h2 class="svc-cta-title" data-edit={`${base}.ctaTitle`}>{page.ctaTitle}</h2>
      <p class="svc-cta-text" data-edit={`${base}.ctaText`}>{page.ctaText}</p>
      {/*
        The form lives on the homepage and posts to one endpoint. Sending people
        there rather than repeating the form keeps a single submit handler and a
        single place for the honeypot; the hash lands them on it directly.
      */}
      <a class="btn-primary" href="/#contact" data-edit={`${base}.ctaButton`}>{page.ctaButton}</a>
      {linkRows.map((row) => (
        <div class="svc-siblings">
          <span class="svc-siblings-label">{row.label}</span>
          {row.pages.map((other) => (
            <a class="svc-sibling" href={`/${other.slug}/`}>{other.crumb}</a>
          ))}
        </div>
      ))}
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(service)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <script>
    // Same accordion as the homepage: one panel open at a time, the button owns
    // the aria state, the item owns the class that drives the height animation.
    const faqItems = Array.from(document.querySelectorAll('.faq-item'));

    faqItems.forEach((item) => {
      const trigger = item.querySelector('.faq-question');
      if (!trigger) return;

      trigger.addEventListener('click', () => {
        const willOpen = !item.classList.contains('is-open');

        faqItems.forEach((other) => {
          other.classList.remove('is-open');
          other.querySelector('.faq-question')?.setAttribute('aria-expanded', 'false');
        });

        if (willOpen) {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>

  <script>
    // Same motion contract as the homepage: GSAP and Lenis (~136 kB raw) load
    // only on a real pointer-capable screen that hasn't asked for reduced
    // motion. Phones get neither — smooth scroll fights native touch and every
    // element animated below is already visible without JavaScript — so the
    // dynamic import keeps those bytes out of the initial chunk entirely.
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isSmallScreen = window.matchMedia('(max-width: 900px)').matches;

    if (!prefersReducedMotion && !isSmallScreen) {
      const [{ gsap }, { ScrollTrigger }, { default: Lenis }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
        import('lenis'),
      ]);

      gsap.registerPlugin(ScrollTrigger);

      // ── Smooth scroll ───────────────────────────────────────────
      const lenis = new Lenis({
        duration: 0.9,
        smoothWheel: true,
      });

      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      // ── Header ──────────────────────────────────────────────────
      // No upward y-offset: .site-header sits at the top of the document, so
      // translating it from a negative y would briefly open scrollable space
      // above y=0 while the tween plays.
      gsap.from('.site-header', { opacity: 0, duration: 0.7, ease: 'power2.out' });
      gsap.from('.nav-link, .nav-cta', {
        y: 10,
        opacity: 0,
        duration: 0.5,
        stagger: 0.06,
        delay: 0.25,
        ease: 'power2.out',
      });

      // ── Hero ────────────────────────────────────────────────────
      gsap
        .timeline({ defaults: { ease: 'power3.out' } })
        .from('.crumbs', { y: 12, opacity: 0, duration: 0.5 }, 0.1)
        .from('.svc-eyebrow', { y: 16, opacity: 0, duration: 0.6 }, 0.2)
        .from('.svc-title', { y: 34, opacity: 0, duration: 0.85 }, 0.32)
        .from('.svc-subtitle', { y: 20, opacity: 0, duration: 0.7 }, 0.55)
        .from('.hero-actions', { y: 18, opacity: 0, duration: 0.6 }, 0.7)
        .from('.hero-scope', { y: 16, opacity: 0, duration: 0.6 }, 0.8);

      // ── Pain ────────────────────────────────────────────────────
      gsap.from('.svc-pain .section-title', {
        scrollTrigger: { trigger: '.svc-pain', start: 'top 75%' },
        y: 24,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
      });

      gsap.from('.svc-pain-card', {
        scrollTrigger: { trigger: '.svc-pain-grid', start: 'top 82%' },
        y: 40,
        opacity: 0,
        duration: 0.65,
        stagger: 0.1,
        ease: 'power3.out',
      });

      // ── Works ───────────────────────────────────────────────────
      gsap.from('.svc-works-title', {
        scrollTrigger: { trigger: '.svc-works', start: 'top 75%' },
        y: 24,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
      });

      gsap.from('.svc-work', {
        scrollTrigger: { trigger: '.svc-works-list', start: 'top 82%' },
        y: 30,
        opacity: 0,
        duration: 0.6,
        stagger: 0.12,
        ease: 'power3.out',
      });

      // ── Proof ───────────────────────────────────────────────────
      // Animated by ServiceProof.astro.

      // ── FAQ ─────────────────────────────────────────────────────
      gsap.from('.faq .section-title', {
        scrollTrigger: { trigger: '.faq', start: 'top 78%' },
        y: 24,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
      });

      gsap.from('.faq-item', {
        scrollTrigger: { trigger: '.faq-list', start: 'top 82%' },
        y: 20,
        opacity: 0,
        duration: 0.55,
        stagger: 0.07,
        ease: 'power3.out',
      });

      // ── CTA ─────────────────────────────────────────────────────
      gsap.from('.svc-cta-inner', {
        scrollTrigger: { trigger: '.svc-cta', start: 'top 78%' },
        scale: 0.97,
        duration: 0.9,
        ease: 'power3.out',
      });

      gsap.from(['.svc-cta-title', '.svc-cta-text', '.svc-cta .btn-primary', '.svc-siblings'], {
        scrollTrigger: { trigger: '.svc-cta', start: 'top 75%' },
        y: 24,
        opacity: 0,
        duration: 0.7,
        stagger: 0.1,
        ease: 'power3.out',
      });

      // ── Footer ──────────────────────────────────────────────────
      gsap.from('.footer-inner', {
        scrollTrigger: { trigger: '.site-footer', start: 'top 92%' },
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: 'power3.out',
      });

      // Fonts/images finishing late (or a scroll position the browser restored
      // before Lenis took over) can leave Lenis and ScrollTrigger holding stale
      // bounds. Recompute once everything has actually settled.
      window.addEventListener('load', () => {
        lenis.resize();
        ScrollTrigger.refresh();
      });
    }
  </script>
</Layout>
