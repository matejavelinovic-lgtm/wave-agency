---
import { getImage } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import '../styles/main.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DevCopyEditor from '../components/DevCopyEditor.astro';
import {
  SITE_URL,
  SITE_NAME,
  SITE_ALT_NAME,
  ORG_PROFILES,
  LOCATION,
  PERSON,
  PERSON_PHOTO,
} from '../consts';

/*
 * Schema image. Referencing PERSON_PHOTO.src here would publish the 5495px
 * camera original, so ask Astro for a sized jpg instead: crawlers read it,
 * no visitor downloads it, and the original never reaches dist.
 */
const schemaPhoto = await getImage({
  src: PERSON_PHOTO,
  width: 800,
  height: 1240,
  format: 'jpg',
  quality: 75,
});

interface Props {
  title?: string;
  description?: string;
  /** Trailing crumbs after Home. Omit on the homepage. */
  breadcrumbs?: { name: string; path: string }[];
  /**
   * og:type. "article" on a blog post, which is what a share card reads to show
   * a byline and a date instead of a plain site preview; "website" everywhere
   * else. Nothing else on this site is an article.
   */
  ogType?: 'website' | 'article';
  /** Share image, site-relative or absolute. Resolved against SITE_URL below. */
  image?: string;
}

const {
  title = 'WaveWeb | Speed and AEO for Web3 and fintech sites, built in Astro',
  description =
    'I speed up Web3 and fintech sites, get them quoted by AI search, and rebuild them in Astro, including sites moving out of Webflow.',
  breadcrumbs = [],
  ogType = 'website',
  image,
} = Astro.props;

/*
 * og:image has to be absolute — a relative path is ignored by every scraper
 * that reads it. Pages that pass nothing fall back to the logo, which is a
 * poorer card than a real image but a far better one than no image at all.
 */
const ogImage = new URL(image ?? '/WaveWeb_Logo.png', SITE_URL).href;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;

/*
 * The brand node. Six other outfits trade under some spelling of this name, so
 * everything here exists to answer one question for a crawler: which "WaveWeb"
 * is this? name and alternateName claim both spellings, logo and image give it
 * a face, founder ties it to a named person who carries a real profile, and
 * sameAs — drawn from ORG_PROFILES — is the part that actually settles the
 * argument. Read the note above it in consts.ts before adding a URL there.
 *
 * sameAs is spread in conditionally rather than emitted empty: [] is a claim to
 * have no profiles at all, a missing key is no claim either way.
 */
const organization = {
  '@context': 'https://schema.org',
  /*
   * Two types, not one. ProfessionalService is a LocalBusiness, which is an
   * Organization, so the pair costs nothing and says both things at once: a
   * company, and a consultancy someone hires. Keeping Organization in the list
   * spares any consumer that matches on the plain type.
   */
  '@type': ['Organization', 'ProfessionalService'],
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  alternateName: SITE_ALT_NAME,
  url: SITE_URL,
  logo: `${SITE_URL}/WaveWeb_Logo.png`,
  image: `${SITE_URL}/WaveWeb_Logo.png`,
  description,
  founder: { '@id': `${SITE_URL}/#person` },
  employee: { '@id': `${SITE_URL}/#person` },
  knowsAbout: [
    'Core Web Vitals',
    'Answer Engine Optimization',
    'Astro development',
    'Website migration',
  ],
  // Based in one place, sells into every other. See LOCATION in consts.ts for
  // why the address stops at the town.
  address: {
    '@type': 'PostalAddress',
    addressLocality: LOCATION.locality,
    addressRegion: LOCATION.region,
    addressCountry: LOCATION.country,
  },
  areaServed: 'Worldwide',
  ...(ORG_PROFILES.length > 0 && { sameAs: ORG_PROFILES }),
};

/*
 * The WebSite node is what a search engine reads to name the site itself,
 * separate from the company that runs it — it is the string Google prints
 * above a result instead of the bare domain. publisher points back at the
 * Organization so the two are one entity and not two.
 */
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_NAME,
  alternateName: SITE_ALT_NAME,
  url: SITE_URL,
  description,
  inLanguage: 'en',
  publisher: { '@id': `${SITE_URL}/#organization` },
};

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: PERSON.name,
  jobTitle: PERSON.jobTitle,
  url: SITE_URL,
  image: new URL(schemaPhoto.src, SITE_URL).href,
  sameAs: [PERSON.linkedin],
  worksFor: { '@id': `${SITE_URL}/#organization` },
  knowsAbout: [
    'Core Web Vitals',
    'Answer Engine Optimization',
    'Astro development',
    'Website migration',
  ],
};

const breadcrumbList = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    item: new URL(crumb.path, SITE_URL).href,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/WaveWeb_Logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!--
      index,follow is the default, so the value of this tag is the rest of it:
      without max-snippet and max-image-preview a search engine is free to clip
      the description to a couple of lines and show a thumbnail or nothing.
      These ask for the full text and a large image, which is what a result for
      a brand nobody has heard of needs.
    -->
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!--
      All three weights paint above the fold, so all three get preloaded: Regular
      carries body copy, Semibold the H1 and every button, Medium the nav links
      and the scope chips under the hero. They are ~12 kB each.
    -->
    <link
      rel="preload"
      href="/fonts/BlauerNue-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/BlauerNue-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/BlauerNue-Semibold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!--
      Blauer Nue, self-hosted from public/fonts as woff2. The stylesheet uses
      four weights and no more: 400 body, 500 nav and chips, 600 labels, 700
      headings. The family ships without a standalone Bold, so Semibold is
      registered at both 600 and 700 and the browser renders the real crafted
      glyphs instead of synthesizing one or matching up to Extrabold. Thin,
      Extralight, Light, Extrabold, and Heavy stay out of the document: a face
      the CSS never asks for is a face the browser never needs to know about.
    -->
    <style>
      @font-face {
        font-family: 'Blauer Nue';
        src: url('/fonts/BlauerNue-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Blauer Nue';
        src: url('/fonts/BlauerNue-Medium.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Blauer Nue';
        src: url('/fonts/BlauerNue-Semibold.woff2') format('woff2');
        font-weight: 600 700;
        font-style: normal;
        font-display: swap;
      }

      /*
       * The anti-CLS half of the font setup. font-display: swap paints the page
       * in whatever the system offers, then repaints it in Blauer Nue — and a
       * plain Arial is ~10% narrower, which was enough to wrap the 68px H1 onto
       * a third line and drop everything under it by one line height. That one
       * reflow was the whole 0.27 CLS on desktop.
       *
       * So the fallback is not plain Arial: it is Arial stretched to Blauer
       * Nue's own measurements, per weight. size-adjust is the ratio of the two
       * average advance widths (measured on a canvas at 100px against a mixed
       * sample of this page's own copy), so a line of text occupies the same
       * width in both and breaks in the same places. ascent/descent-override
       * put the baseline where Blauer Nue puts it — 94% / 26% of the em — and
       * each is divided by its own size-adjust because the browser applies the
       * override first and scales the result.
       *
       * Re-measure all six numbers if the font files are ever replaced.
       */
      @font-face {
        font-family: 'Blauer Fallback';
        src: local('Arial'), local('Liberation Sans'), local('Helvetica Neue'), local('Roboto');
        font-weight: 400;
        size-adjust: 110.61%;
        ascent-override: 84.98%;
        descent-override: 23.51%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: 'Blauer Fallback';
        src: local('Arial'), local('Liberation Sans'), local('Helvetica Neue'), local('Roboto');
        font-weight: 500;
        size-adjust: 109.74%;
        ascent-override: 85.66%;
        descent-override: 23.69%;
        line-gap-override: 0%;
      }
      @font-face {
        font-family: 'Blauer Fallback';
        src: local('Arial'), local('Liberation Sans'), local('Helvetica Neue'), local('Roboto');
        font-weight: 600 700;
        size-adjust: 103.52%;
        ascent-override: 90.80%;
        descent-override: 25.12%;
        line-gap-override: 0%;
      }
    </style>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(website)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbList)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    {import.meta.env.DEV && <DevCopyEditor />}
    <Analytics />
  </body>
</html>
