---
// Site footer.
import { SITE_NAME, PERSON } from '../consts';
import copy from '../content/copy.json';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img class="footer-mark" src="/WaveWeb_Logo.png" alt={SITE_NAME} width="28" height="28" />
      <p class="footer-text">
        © {year} {SITE_NAME}. <span data-edit="footer.text">{copy.footer.text}</span>
      </p>
    </div>
    <!--
      The four service pages, straight from the list that builds them, so a new
      service appears here the moment it exists in copy.json. Crumb rather than
      the page's own H1: the H1 is a sentence, this is a label in a row.
    -->
    <nav class="footer-links" aria-label="Services">
      {copy.servicePages.map((page) => (
        <a class="footer-link" href={`/${page.slug}/`}>{page.crumb}</a>
      ))}
    </nav>
    <div class="footer-links">
      <a class="footer-link" href="/#faq">FAQ</a>
      <a class="footer-link" href="/#contact">Contact</a>
      <a class="footer-link" href={PERSON.linkedin} rel="noopener" target="_blank">LinkedIn</a>
    </div>
  </div>
</footer>
