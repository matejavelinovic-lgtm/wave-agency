---
// Site header / navigation. Every element carries a semantic class defined in
// src/styles/main.css — click any of them in the visual editor to edit its rule.
import { SITE_NAME } from '../consts';
import copy from '../content/copy.json';

// Trailing slash included, matching the hrefs below, so the service page you
// are on can mark its own entry in the menu.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<header class="site-header">
  <nav class="site-nav">
    <a class="nav-brand" href="/">
      <img class="nav-mark" src="/WaveWeb_Logo.png" alt={SITE_NAME} width="34" height="34" />
      <span class="nav-wordmark">{SITE_NAME}</span>
    </a>
    <div class="nav-links">
      {/*
        The menu opens on hover and on focus, in CSS alone: tabbing onto
        Services opens it, and the next Tab walks into its links. The link
        itself still goes to the homepage section, so a touch screen that never
        hovers loses nothing. The caret sits outside the link because the
        letter scramble below rewrites the link's whole text content.
        Entries come from servicePages, like the footer's.
      */}
      <div class="nav-item">
        <a class="nav-link" href="/#services">Services</a>
        <span class="nav-caret" aria-hidden="true"></span>
        <div class="nav-menu">
          <ul class="nav-menu-list">
            {
              copy.servicePages.map((page, i) => (
                <li class="nav-menu-item">
                  <a
                    class="nav-menu-link"
                    href={`/${page.slug}/`}
                    aria-current={path === `/${page.slug}/` ? 'page' : undefined}
                  >
                    <span class="nav-menu-index">0{i + 1}</span>
                    <span class="nav-menu-label">{page.crumb}</span>
                    <span class="nav-menu-arrow" aria-hidden="true" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <a class="nav-link" href="/pricing/">Pricing</a>
      <a class="nav-link" href="/#process">Process</a>
      <a class="nav-link" href="/#faq">FAQ</a>
      <a class="nav-link" href="/blog/">Blog</a>
      <a class="nav-cta" href="/#contact">Let’s talk</a>
    </div>
  </nav>
</header>

<script>
  const MATRIX_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ!<>-_/[]{}=+*^#';

  function randChar() {
    return MATRIX_CHARS[Math.floor(Math.random() * MATRIX_CHARS.length)];
  }

  function splitLetters(el: Element) {
    const text = el.textContent ?? '';
    el.textContent = '';
    const spans: HTMLSpanElement[] = [];
    for (const ch of text) {
      if (ch === ' ') {
        el.appendChild(document.createTextNode(' '));
        continue;
      }
      const span = document.createElement('span');
      span.className = 'nav-letter';
      span.textContent = ch;
      span.dataset.final = ch;
      el.appendChild(span);
      spans.push(span);
    }
    return spans;
  }

  function scramble(span: HTMLSpanElement, delay: number, duration: number, frame: number) {
    const start = performance.now() + delay;
    const end = start + duration;
    function tick(now: number) {
      if (now < start) {
        requestAnimationFrame(tick);
        return;
      }
      if (now >= end) {
        span.textContent = span.dataset.final ?? '';
        return;
      }
      span.textContent = randChar();
      setTimeout(() => requestAnimationFrame(tick), frame);
    }
    requestAnimationFrame(tick);
  }

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    document.querySelectorAll<HTMLAnchorElement>('.nav-link').forEach((link) => {
      const spans = splitLetters(link);
      link.addEventListener('mouseenter', () => {
        link.classList.add('is-decoding');
        let maxFinish = 0;
        spans.forEach((span, i) => {
          const delay = i * 35;
          const duration = 160;
          scramble(span, delay, duration, 35);
          maxFinish = Math.max(maxFinish, delay + duration);
        });
        setTimeout(() => link.classList.remove('is-decoding'), maxFinish + 20);
      });
    });
  }
</script>
